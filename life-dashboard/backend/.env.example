# Copy this file to .env and fill in real values. Never commit .env.

# --- Google Calendar ---
# Create an OAuth client (type: Desktop app) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in automatically the first time you run `npm run google:auth`
GOOGLE_REFRESH_TOKEN=

# --- Apple iCloud CalDAV ---
# Use the Apple ID email you use for iCloud, and an app-specific password
# generated at https://account.apple.com/account/manage (Sign-In and Security
# > App-Specific Passwords). Your normal Apple ID password will NOT work here.
APPLE_ID_EMAIL=
APPLE_APP_SPECIFIC_PASSWORD=

# --- Learn.UQ (Blackboard Ultra) calendar feed ---
# Learn.UQ > Calendar > Calendar Settings > Share Calendar > copy link.
# Leave blank until you've confirmed this option exists for your account.
LEARNUQ_ICS_URL=

# --- Database ---
DB_PATH=./data/life-dashboard.sqlite
